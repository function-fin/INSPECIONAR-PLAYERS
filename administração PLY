-- ============================================================
-- LÓGICA DO VIEW 3D
-- ============================================================
local function stopPreview()
    previewToken += 1
    if previewConnection then pcall(function() previewConnection:Disconnect() end) previewConnection = nil end
    if previewModel then pcall(function() previewModel:Destroy() end) previewModel = nil end
    previewViewport = nil
end

local function createViewport(parent)
    local old = parent:FindFirstChild("Preview") if old then old:Destroy() end
    local vp = create("ViewportFrame", parent, { Name = "Preview", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ZIndex = 604 })
    local wm = create("WorldModel", vp, {})
    local cam = create("Camera", vp, { FieldOfView = 30 })
    vp.CurrentCamera = cam
    return vp, wm, cam
end

local function startPreview(player)
    stopPreview()
    local token = previewToken
    hoverStatus.Text = "Carregando..."
    hoverStatus.Visible = true
    
    task.spawn(function()
        local char = player.Character
        if not char then
            hoverStatus.Text = "Personagem não carregado."
            return
        end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then
            hoverStatus.Text = "Humanoid não encontrado."
            return
        end
        
        local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
        if not ok or not desc then
            hoverStatus.Text = "Falha ao obter descrição."
            return
        end
        
        local rigType = (hum.RigType == Enum.HumanoidRigType.R6) and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15
        local okModel, model = pcall(function()
            return Players:CreateHumanoidModelFromDescriptionAsync(desc, rigType)
        end)
        
        pcall(function() desc:Destroy() end)
        
        if not okModel or not model then
            hoverStatus.Text = "Falha ao criar modelo 3D."
            return
        end
        
        if token ~= previewToken then 
            pcall(function() model:Destroy() end) 
            return 
        end
        
        local vp, wm, cam = createViewport(viewportHolder)
        model.Parent = wm
        model:PivotTo(CFrame.new(0, 0, 0))
        previewModel = model
        previewViewport = vp
        
        local head = model:FindFirstChild("Head", true)
        local root = model:FindFirstChild("HumanoidRootPart", true) or head or model.PrimaryPart
        
        if root then
            local cf, size = model:GetBoundingBox()
            local focusPoint = root.Position 
            
            if head then
                focusPoint = head.Position - Vector3.new(0, size.Y * 0.25, 0)
            end

            local look = head and head.CFrame.LookVector or root.CFrame.LookVector
            if look.Magnitude == 0 then look = Vector3.new(0, 0, -1) end
            
            -- Aproxima a câmera em 10% para deixar a skin maior no espaço do viewport
            local distance = math.max(math.max(size.Y, size.X, size.Z) * 2.8, 8) * 0.9
            
            cam.CFrame = CFrame.lookAt(focusPoint + look.Unit * distance, focusPoint)
        end
        
        hoverStatus.Visible = false
        
        local angle = 0
        previewConnection = RunService.RenderStepped:Connect(function(dt)
            if token ~= previewToken or not previewViewport then stopPreview() return end
            angle += dt * math.rad(70)
            pcall(function() model:PivotTo(CFrame.Angles(0, angle, 0)) end)
        end)
    end)
end

-- ============================================================
-- LÓGICA DE NAVEGAÇÃO E LISTA
-- ============================================================

local function applyCardSelectionVisual(stroke, displayLbl, userLbl, isSelected)
    stroke.Color = isSelected and BORDER_SELECTED or BORDER_UNSELECTED
    stroke.Thickness = isSelected and 2.5 or 2
    displayLbl.TextColor3 = isSelected and TEXT_BRIGHT or TEXT_MUTED
    userLbl.TextColor3 = isSelected and TEXT_SUB_BRIGHT or TEXT_SUB_MUTED
end

local function updateList()
    for _, v in pairs(playerList:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    
    local filter = searchBox.Text:lower()
    local players = Players:GetPlayers()
    
    table.sort(players, function(a, b)
        if a == LP then return true end
        if b == LP then return false end
        local aFriend = LP:IsFriendsWith(a.UserId)
        local bFriend = LP:IsFriendsWith(b.UserId)
        if aFriend and not bFriend then return true end
        if bFriend and not aFriend then return false end
        return a.Name:lower() < b.Name:lower()
    end)
    
    for _, p in ipairs(players) do
        if filter == "" or p.Name:lower():find(filter) or p.DisplayName:lower():find(filter) then
            local isSelected = (selectedUserId == p.UserId)
            
            local btn, btnStroke = create("TextButton", playerList, { 
                Size = UDim2.new(1, -4, 0, 46), 
                BackgroundColor3 = Color3.fromRGB(0, 0, 0), 
                AutoButtonColor = false,
                Text = "", 
                ZIndex = 605 
            }, 6, isSelected and BORDER_SELECTED or BORDER_UNSELECTED, isSelected and 2.5 or 2)
            
            local displayLbl = create("TextLabel", btn, { 
                Size = UDim2.new(1, -18, 0, 19), 
                Position = UDim2.new(0, 10, 0, 5), 
                BackgroundTransparency = 1, 
                Text = p.DisplayName, 
                TextColor3 = isSelected and TEXT_BRIGHT or TEXT_MUTED, 
                Font = ARCADE_FONT, 
                TextSize = 14, 
                TextXAlignment = Enum.TextXAlignment.Left, 
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 606 
            })
            
            local userLbl = create("TextLabel", btn, { 
                Size = UDim2.new(1, -18, 0, 15), 
                Position = UDim2.new(0, 10, 0, 24), 
                BackgroundTransparency = 1, 
                Text = "@" .. p.Name, 
                TextColor3 = isSelected and TEXT_SUB_BRIGHT or TEXT_SUB_MUTED, 
                Font = ARCADE_FONT, 
                TextSize = 11, 
                TextXAlignment = Enum.TextXAlignment.Left, 
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 606 
            })

            btn.MouseEnter:Connect(function()
                applyCardSelectionVisual(btnStroke, displayLbl, userLbl, true)
            end)

            btn.MouseLeave:Connect(function()
                applyCardSelectionVisual(btnStroke, displayLbl, userLbl, selectedUserId == p.UserId)
            end)
            
            btn.MouseButton1Click:Connect(function()
                selectedUserId = p.UserId
                currentInspectedPlayer = p
                applyCardSelectionVisual(btnStroke, displayLbl, userLbl, true)
                
                nameVal.Text = p.Name
                displayVal.Text = p.DisplayName
                idVal.Text = tostring(p.UserId)
                ageVal.Text = tostring(p.AccountAge)
                playerNameDisplay.Text = p.DisplayName
                
                task.delay(0.08, function()
                    if not sg or not sg.Parent then return end
                    listPage.Visible = false
                    detailPage.Visible = true
                    startPreview(p)
                end)
            end)
        end
    end
end

